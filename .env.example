# Copy to .env.local. Never commit a real key.
# Without QLOO_API_KEY the app uses the in-memory demo catalog.

QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional. Leave blank to keep the ungrounded column on the local guidebook baseline.
# Nothing is called, and nothing is billed, until LLM_API_KEY is set.
#
# Free local (Ollama):
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL=llama3.2
#   LLM_API_KEY=ollama
#
# Free tier, quota then paid (confirm the current model name):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_API_KEY=...
#
# Gemini free tier in Google AI Studio (quota, then paid):
#   LLM_PROVIDER=gemini
#   LLM_MODEL=gemini-2.5-flash
#   LLM_API_KEY=...
#
# OpenAI and most other hosted models cost money from the first request:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o-mini
#   LLM_API_KEY=...

LLM_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
